{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc:*)",
      "Bash(npx next lint:*)",
      "Bash(npx tsx:*)",
      "Bash(node:*)",
      "Bash(rtk:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",

      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(du:*)"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(sudo:*)",
      "Bash(setx:*)"
    ]
  }
}
