{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser", "chromium",
        "--viewport-size", "375x812",
        "--output-dir", ".playwright-mcp"
      ]
    }
  }
}
